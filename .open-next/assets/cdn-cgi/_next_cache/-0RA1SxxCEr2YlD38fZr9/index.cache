fnrhj.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Fw2trusttrade-furniture%2Fphotoset%2Fset_1.jpg&amp;w=1200&amp;q=100 1200w, /_next/image?url=https%3A%2F%2Funijywgetgmmouifnrhj.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Fw2trusttrade-furniture%2Fphotoset%2Fset_1.jpg&amp;w=1920&amp;q=100 1920w, /_next/image?url=https%3A%2F%2Funijywgetgmmouifnrhj.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Fw2trusttrade-furniture%2Fphotoset%2Fset_1.jpg&amp;w=2048&amp;q=100 2048w, /_next/image?url=https%3A%2F%2Funijywgetgmmouifnrhj.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Fw2trusttrade-furniture%2Fphotoset%2Fset_1.jpg&amp;w=3840&amp;q=100 3840w\" src=\"/_next/image?url=https%3A%2F%2Funijywgetgmmouifnrhj.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Fw2trusttrade-furniture%2Fphotoset%2Fset_1.jpg&amp;w=3840&amp;q=100\"/></div></section><section class=\"w-full relative text-primary1\" id=\"aboutUs\"><div class=\"p-[3em] bg-primary5\"><header class=\"text-center\"><h3 class=\"font-h1 pb-[1em]\">About Us</h3></header><p class=\"font-b1\">&#x27;WilNWin Furniture creates custom, eco-friendly furniture that transforms spaces into reflections of your unique style. We craft durable, beautiful pieces with sustainability in mind, ensuring every creation supports both your vision and the planet.&#x27;</p></div></section><section class=\"w-full relative text-primary5\" id=\"vision\"><div class=\"p-[3em] bg-primary1\"><header class=\"text-center mb-[2em]\"><h3 class=\"font-h1 pb-[1em]\">Our Vision</h3></header><div class=\"flex flex-wrap justify-center gap-[1.5em] text-primary1\"><div class=\"flex flex-col items-center text-center bg-white p-6 rounded-lg shadow-md  min-w-[250px] sm:min-w-[300px] w-full sm:w-[48%] md:w-[30%] lg:w-[18%]\"><header class=\"font-bold text-lg flex items-center justify-center space-x-2\"><span>🌍</span><span>Sustainable Future</span></header><p class=\"text-sm mt-2\">Creating furniture with eco-friendly materials and responsible sourcing.</p></div><div class=\"flex flex-col items-center text-center bg-white p-6 rounded-lg shadow-md  min-w-[250px] sm:min-w-[300px] w-full sm:w-[48%] md:w-[30%] lg:w-[18%]\"><header class=\"font-bold text-lg flex items-center justify-center space-x-2\"><span>🎨</span><span>Timeless Craftsmanship</span></header><p class=\"text-sm mt-2\">Blending tradition with innovation for designs that last a lifetime.</p></div><div class=\"flex flex-col items-center text-center bg-white p-6 rounded-lg shadow-md  min-w-[250px] sm:min-w-[300px] w-full sm:w-[48%] md:w-[30%] lg:w-[18%]\"><header class=\"font-bold text-lg flex items-center justify-center space-x-2\"><span>🏡</span><span>Personalized Living</span></header><p class=\"text-sm mt-2\">Bringing your unique style to life with fully customizable furniture.</p></div><div class=\"flex flex-col items-center text-center bg-white p-6 rounded-lg shadow-md  min-w-[250px] sm:min-w-[300px] w-full sm:w-[48%] md:w-[30%] lg:w-[18%]\"><header class=\"font-bold text-lg flex items-center justify-center space-x-2\"><span>🤝</span><span>Global Reach, Personal Touch</span></header><p class=\"text-sm mt-2\">Connecting with clients worldwide while maintaining a handcrafted, personal approach.</p></div><div class=\"flex flex-col items-center text-center bg-white p-6 rounded-lg shadow-md  min-w-[250px] sm:min-w-[300px] w-full sm:w-[48%] md:w-[30%] lg:w-[18%]\"><header class=\"font-bold text-lg flex items-center justify-center space-x-2\"><span>🚀</span><span>Pushing Boundaries</span></header><p class=\"text-sm mt-2\">Continuously evolving to redefine custom furniture with new designs and techniques.</p></div></div></div></section><section class=\"w-full relative text-primary1 bg-primary5\" id=\"howToOrder\"><div class=\"p-[3em]\"><header><h3 class=\"font-h1 pb-[1em]\">How To Order</h3></header><div class=\"font-b1\"><table class=\"clsHowToOrderTable\"><tbody><tr><td><img alt=\"TOP icon\" loading=\"lazy\" width=\"30\" height=\"30\" decoding=\"async\" data-nimg=\"1\" class=\"mr-[1em] invert\" style=\"color:transparent\" src=\"/_next/static/media/credit-card.465b3b4a.svg\"/></td><td><b>Term Of Payment</b></td><td>70% Down Payment after Proforma Invoice Signed , 30% Remaining Balance by Document Against Payment.</td></tr><tr><td><img alt=\"TOP icon\" loading=\"lazy\" width=\"30\" height=\"30\" decoding=\"async\" data-nimg=\"1\" class=\"mr-[1em] invert\" style=\"color:transparent\" src=\"/_next/static/media/dollar-sign.5c043965.svg\"/></td><td><b>Pricing</b></td><td>US $ FOB Jakarta - Indonesia. (call for detail / prices)</td></tr><tr><td><img alt=\"TOP icon\" loading=\"lazy\" width=\"30\" height=\"30\" decoding=\"async\" data-nimg=\"1\" class=\"mr-[1em] invert\" style=\"color:transparent\" src=\"/_next/static/media/clock.c3033df2.svg\"/></td><td><b>Delivery Time</b></td><td> 1 x 20 &quot; container, consists of 5-10 Items.</td></tr><tr><td><img alt=\"TOP icon\" loading=\"lazy\" width=\"30\" height=\"30\" decoding=\"async\" data-nimg=\"1\" class=\"mr-[1em] invert\" style=\"color:transparent\" src=\"/_next/static/media/truck.2800ef7c.svg\"/></td><td><b>Minimum Order</b></td><td>70% Down Payment after Proforma Invoice Signed , 30% Remaining Balance by Document Against Payment.</td></tr><tr><td><img alt=\"TOP icon\" loading=\"lazy\" width=\"30\" height=\"30\" decoding=\"async\" data-nimg=\"1\" class=\"mr-[1em] invert\" style=\"color:transparent\" src=\"/_next/static/media/package.b935ea3f.svg\"/></td><td><b>Packaging</b></td><td> Double Wall cart carton box, with styrofoam / cardboard protection.</td></tr></tbody></table></div></div></section><section id=\"featuredProducts\" class=\"w-full bg-primary1 text-primary5 py-[3em] pb-[5em]\"><div class=\"text-center mb-[2em]\"><h3 class=\"font-h1 pb-[1em]\">Featured Products</h3><p>Explore our curated selection of premium, custom-made furniture</p></div><div class=\"flex flex-wrap justify-center gap-[1.5em]\"><div class=\"min-w-[300px] sm:min-w-[350px] min-h-[50vh] w-[30%] sm:w-[30%] md:w-[30%] lg:w-[30%]\